@using IdentityMail.web.DTOs.UserDtos.UserMessageDtos
@model SendMailDto
@{
    ViewData["Title"] = "Yeni Mail";
}

<!-- Bootstrap Icons & Google Fonts (Poppins) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --brand-1: #022c22;
        --brand-2: #064e3b;
        --brand-3: #059669;
        --brand-4: #10b981;
        --brand-5: #06b6d4;
        --glass-bg: rgba(255, 255, 255, 0.90);
        --glass-border: rgba(255, 255, 255, 0.45);
        --glass-shadow: 0 20px 45px rgba(2, 44, 34, 0.25);
        --text-main: #0f172a;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Poppins', sans-serif;
    }

    body {
        background: linear-gradient(-45deg, #022c22, #064e3b, #0f766e, #042f2e);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        min-height: 100vh;
        margin: 0;
    }

    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .container,
    .container-fluid,
    main[role="main"] {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
    }

    .compose-wrapper {
        min-height: 100vh;
        width: 100%;
        padding: 40px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .glass-editor-card {
        background: var(--glass-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        border-radius: 24px;
        width: 100%;
        max-width: 860px;
        overflow: hidden;
        animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .editor-topbar {
        background: rgba(255, 255, 255, 0.7);
        padding: 24px 32px;
        border-bottom: 1px solid rgba(226, 232, 240, 0.8);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .editor-body {
        padding: 32px;
    }

    /* Modern E-Posta Satırları */
    .field-row {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.2s ease;
        margin-bottom: 16px;
    }

        .field-row:focus-within {
            border-color: var(--brand-3);
            box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
        }

    .field-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #475569;
        min-width: 90px;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .field-input {
        border: none;
        background: transparent;
        width: 100%;
        padding: 6px 0;
        color: var(--text-main);
        font-size: 0.95rem;
        outline: none;
    }

    .field-select {
        border: none;
        background: transparent;
        width: 100%;
        padding: 6px 0;
        color: var(--text-main);
        font-size: 0.95rem;
        outline: none;
        cursor: pointer;
    }

    .textarea-container {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 16px;
        transition: all 0.2s ease;
    }

        .textarea-container:focus-within {
            border-color: var(--brand-3);
            box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
        }

    .field-textarea {
        border: none;
        background: transparent;
        width: 100%;
        resize: vertical;
        min-height: 200px;
        color: var(--text-main);
        font-size: 0.95rem;
        outline: none;
        line-height: 1.6;
    }

    .editor-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 24px;
        gap: 12px;
    }

    .btn-send {
        background: linear-gradient(135deg, #059669, #0891b2);
        color: #ffffff;
        border: none;
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 6px 16px rgba(5, 150, 105, 0.3);
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .btn-send:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(5, 150, 105, 0.4);
            color: #ffffff;
        }

    .btn-back {
        background: #ffffff;
        color: #475569;
        border: 1px solid #e2e8f0;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

        .btn-back:hover {
            background: #f8fafc;
            color: var(--brand-3);
            border-color: #cbd5e1;
        }

    @@media (max-width: 768px) {
        .editor-topbar, .editor-body {
            padding: 20px;
        }

        .field-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }

        .field-label {
            min-width: auto;
        }

        .editor-footer {
            flex-direction: column-reverse;
        }

        .btn-send, .btn-back {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="compose-wrapper">
    <div class="glass-editor-card">

        <!-- Üst Başlık Şeridi -->
        <div class="editor-topbar">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; font-size: 1.2rem;">
                    <i class="bi bi-pencil-fill"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-dark">Yeni Mesaj Oluştur</h5>
                    <small class="text-muted">E-posta detaylarını girip doğrudan iletebilirsiniz.</small>
                </div>
            </div>
            <a asp-controller="Message" asp-action="Index" class="btn-close" aria-label="Kapat" title="İptal"></a>
        </div>

        <!-- Editör Alanı -->
        <div class="editor-body">
            <form method="post">

                <!-- Alıcı Satırı -->
                <div class="field-row">
                    <label asp-for="ReceiverMail" class="field-label">
                        <i class="bi bi-person text-success me-1"></i> Alıcı:
                    </label>
                    <input asp-for="ReceiverMail" type="email" class="field-input" placeholder="alici@example.com" required autocomplete="off" />
                </div>

                <!-- Konu Satırı -->
                <div class="field-row">
                    <label asp-for="Subject" class="field-label">
                        <i class="bi bi-chat-text text-success me-1"></i> Konu:
                    </label>
                    <input asp-for="Subject" type="text" class="field-input" placeholder="Mesaj konusu" required />
                </div>

                <!-- Kategori Seçim Satırı -->
                <div class="field-row">
                    <label asp-for="CategoryId" class="field-label">
                        <i class="bi bi-folder2-open text-success me-1"></i> Kategori:
                    </label>
                    <select asp-for="CategoryId" class="field-select">
                        <option value="">📂 Kategori Seçiniz (İsteğe Bağlı)</option>
                        @if (ViewBag.Categories != null)
                        {
                            @foreach (var item in ViewBag.Categories)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Mesaj İçeriği -->
                <div class="textarea-container mt-3">
                    <textarea asp-for="Body" class="field-textarea" placeholder="Mesajınızı buraya yazın..." rows="8"></textarea>
                </div>

                <!-- Hata Alanı -->
                <div class="mt-3">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger small fw-medium" })
                </div>

                <!-- Aksiyon Çubuğu -->
                <div class="editor-footer">
                    <a asp-controller="Message" asp-action="Index" class="btn-back">
                        <i class="bi bi-arrow-left"></i> Vazgeç
                    </a>

                    <button type="submit" class="btn-send">
                        <i class="bi bi-send-fill"></i> Gönder
                    </button>
                </div>

            </form>
        </div>

    </div>
</div>


