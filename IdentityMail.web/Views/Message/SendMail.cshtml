@using IdentityMail.web.DTOs.UserDtos.UserMessageDtos
@model SendMailDto
@{
    ViewData["Title"] = "Yeni Mail";
}

<!-- Bootstrap Icons & Google Fonts (Poppins) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* ========== THEME & VARIABLES ========== */
    :root {
        --brand-1: #022c22;
        --brand-2: #064e3b;
        --brand-3: #059669;
        --brand-4: #10b981;
        --brand-5: #06b6d4;
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(255, 255, 255, 0.4);
        --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.12);
        --text-main: #0f172a;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Poppins', sans-serif;
    }

    /* ========== ANIMATED BACKGROUND ========== */
    .mail-shell {
        min-height: 100vh;
        padding: 40px 24px;
        background: linear-gradient(-45deg, #022c22, #064e3b, #0f766e, #042f2e);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        color: var(--text-main);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ========== GLASSMORPHISM CONTAINER ========== */
    .glass-compose-card {
        background: var(--glass-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        border-radius: 24px;
        width: 100%;
        max-width: 850px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ========== COMPOSE HEADER ========== */
    .compose-header {
        padding: 35px 40px;
        border-bottom: 1px solid rgba(226, 232, 240, 0.6);
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .icon-circle-premium {
        width: 65px;
        height: 65px;
        border-radius: 20px;
        background: linear-gradient(135deg, #10b981, #06b6d4);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
        flex-shrink: 0;
    }

    .header-text h2 {
        font-weight: 800;
        font-size: 1.6rem;
        color: var(--text-main);
        margin: 0 0 4px 0;
    }

    .header-text p {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin: 0;
    }

    /* ========== FORM ELEMENTS ========== */
    .compose-body {
        padding: 40px;
    }

    .form-label-premium {
        font-weight: 700;
        font-size: 0.9rem;
        color: #334155;
        margin-bottom: 8px;
        display: block;
    }

    .premium-input-group {
        position: relative;
        display: flex;
        align-items: center;
    }

        .premium-input-group i {
            position: absolute;
            left: 20px;
            color: var(--text-muted);
            font-size: 1.1rem;
            z-index: 10;
            transition: color 0.25s ease;
        }

    .form-control-premium {
        width: 100%;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 16px;
        padding: 14px 20px 14px 50px;
        font-size: 0.95rem;
        color: var(--text-main);
        transition: all 0.25s ease;
        box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.02);
        outline: none;
    }

    .premium-input-group textarea.form-control-premium {
        padding: 18px 20px;
        resize: vertical;
        min-height: 180px;
    }

    .form-control-premium:focus {
        background: #ffffff;
        border-color: #059669;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2);
    }

    .premium-input-group:focus-within i {
        color: #059669;
    }

    .form-select-premium {
        height: 52px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        background: rgba(255, 255, 255, 0.6);
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 500;
        box-shadow: none;
        transition: 0.25s ease;
        padding: 0 20px;
        width: 100%;
        outline: none;
    }

        .form-select-premium:focus {
            background: #ffffff;
            border-color: #059669;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2);
        }

    .validation-box ul {
        margin: 0;
        padding-left: 20px;
        color: #ef4444;
        font-weight: 500;
        font-size: 0.9rem;
    }

    /* ========== FOOTER ACTIONS ========== */
    .compose-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 30px;
        gap: 16px;
        flex-wrap: wrap;
    }

    .btn-premium-primary {
        padding: 14px 32px;
        border-radius: 14px;
        font-weight: 700;
        background: linear-gradient(135deg, #059669, #0891b2);
        color: #fff;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
        transition: all 0.25s ease;
        cursor: pointer;
        font-size: 1rem;
    }

        .btn-premium-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(16, 185, 129, 0.45);
            color: #fff;
        }

    .btn-premium-secondary {
        padding: 14px 28px;
        border-radius: 14px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.7);
        color: var(--text-main);
        border: 1px solid rgba(255, 255, 255, 0.9);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.25s ease;
        font-size: 0.95rem;
    }

        .btn-premium-secondary:hover {
            background: #ffffff;
            color: #059669;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        }

    /* ========== ANIMATIONS ========== */
    .animate-fade-up {
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 768px) {
        .mail-shell {
            padding: 20px 12px;
        }

        .compose-header, .compose-body {
            padding: 24px;
        }

        .compose-footer {
            flex-direction: column-reverse;
        }

        .btn-premium-primary, .btn-premium-secondary {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="mail-shell">
    <div class="glass-compose-card animate-fade-up">

        <!-- Sayfa Başlığı -->
        <div class="compose-header">
            <div class="icon-circle-premium">
                <i class="bi bi-send-fill"></i>
            </div>
            <div class="header-text">
                <h2>Yeni Mail Oluştur</h2>
                <p>Alıcı bilgilerini doldurun ve mesajınızı gönderin.</p>
            </div>
        </div>

        <!-- Form Alanı -->
        <div class="compose-body">
            <form method="post">

                <!-- Alıcı E-Posta -->
                <div class="mb-4">
                    <label asp-for="ReceiverMail" class="form-label-premium">
                        Alıcı E-Posta
                    </label>
                    <div class="premium-input-group">
                        <i class="bi bi-person"></i>
                        <input asp-for="ReceiverMail"
                               class="form-control-premium"
                               type="email"
                               placeholder="alici@example.com" />
                    </div>
                </div>

                <!-- Konu -->
                <div class="mb-4">
                    <label asp-for="Subject" class="form-label-premium">
                        Konu
                    </label>
                    <div class="premium-input-group">
                        <i class="bi bi-chat-left-text"></i>
                        <input asp-for="Subject"
                               class="form-control-premium"
                               placeholder="Mesaj konusu" />
                    </div>
                </div>

                <!-- Kategori -->
                <div class="mb-4">
                    <label asp-for="CategoryId" class="form-label-premium">
                        Kategori
                    </label>
                    <select asp-for="CategoryId" class="form-select-premium">
                        <option value="">📂 Kategori Seçiniz</option>
                        @if (ViewBag.Categories != null)
                        {
                            @foreach (var item in ViewBag.Categories)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Mesaj Gövdesi -->
                <div class="mb-4">
                    <label asp-for="Body" class="form-label-premium">
                        Mesaj
                    </label>
                    <div class="premium-input-group">
                        <textarea asp-for="Body"
                                  class="form-control-premium"
                                  placeholder="Mesajınızı buraya yazın..."></textarea>
                    </div>
                </div>

                <!-- Hata Mesajları -->
                <div class="validation-box mb-3">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                </div>

                <!-- Aksiyon Butonları -->
                <div class="compose-footer">
                    <a asp-controller="Message"
                       asp-action="Index"
                       class="btn-premium-secondary">
                        <i class="bi bi-arrow-left"></i>
                        İptal ve Geri Dön
                    </a>

                    <button type="submit" class="btn-premium-primary">
                        <i class="bi bi-send-check-fill"></i>
                        Maili Gönder
                    </button>
                </div>

            </form>
        </div>

    </div>
</div>