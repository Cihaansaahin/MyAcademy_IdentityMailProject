@model UserMessage
@{
    ViewData["Title"] = "SendMail";
}

<h1>Gelen Mailler</h1>
<table>

    <tr>
        <th>Gönderen Ad Soyad:</th>
        <td>@Model.Sender.FirstName @Model.Sender.LastName</td>
    </tr>
    <tr>
        <th>Gönderen Email:</th>
        <td>@Model.Sender.Email</td>
    </tr>
    <tr>
        <th>Konu:</th>
        <td>@Model.Subject</td>

    </tr>
    <tr>
        <th>Tarih:</th>
        <td>@Model.SendDate</td>
    </tr>
    <tr>
        <th>Mail İçeriği:</th>
        <td>@Model.Body</td>
    </tr>
</table>
<a href="/Message/Index" class="btn btn-dark">Mesajlara Geri Dön</a>