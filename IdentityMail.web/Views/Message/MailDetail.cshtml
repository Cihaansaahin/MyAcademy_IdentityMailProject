@model UserMessage
@{
    ViewData["Title"] = "Mail Detayı";
}
<!-- Bootstrap Icons & Google Fonts (Poppins) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* ========== THEME & VARIABLES ========== */
    :root {
        --brand-1: #022c22;
        --brand-2: #064e3b;
        --brand-3: #059669;
        --brand-4: #10b981;
        --brand-5: #06b6d4;
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(255, 255, 255, 0.4);
        --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.12);
        --text-main: #0f172a;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Poppins', sans-serif;
    }

    /* ========== ANIMATED BACKGROUND ========== */
    .mail-shell {
        min-height: 100vh;
        padding: 40px 24px;
        background: linear-gradient(-45deg, #022c22, #064e3b, #0f766e, #042f2e);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        color: var(--text-main);
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ========== GLASSMORPHISM CONTAINER ========== */
    .glass-detail-card {
        background: var(--glass-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        border-radius: 24px;
        width: 100%;
        max-width: 900px;
        padding: 40px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    /* ========== DETAIL HEADER & TOP BAR ========== */
    .detail-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.8);
        color: var(--text-main);
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
    }

        .btn-back:hover {
            background: #ffffff;
            color: var(--brand-3);
            transform: translateX(-4px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        }

    .mail-date-badge {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        background: rgba(241, 245, 249, 0.7);
        padding: 8px 16px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    /* ========== SENDER INFO ========== */
    .sender-box {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-bottom: 24px;
        border-bottom: 1px solid rgba(226, 232, 240, 0.6);
        margin-bottom: 24px;
    }

    .sender-avatar {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: linear-gradient(135deg, #10b981, #06b6d4);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.5rem;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.25);
        flex-shrink: 0;
    }

    .sender-info {
        flex: 1;
        min-width: 0;
    }

    .sender-name {
        font-weight: 800;
        font-size: 1.15rem;
        color: var(--text-main);
        margin: 0 0 2px 0;
    }

    .sender-email {
        font-size: 0.88rem;
        color: var(--text-muted);
        margin: 0;
    }

    /* ========== SUBJECT & BODY ========== */
    .mail-subject {
        font-weight: 800;
        font-size: 1.75rem;
        color: var(--text-main);
        margin-bottom: 24px;
        line-height: 1.3;
    }

    .mail-body-container {
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 16px;
        padding: 30px;
        min-height: 250px;
        margin-bottom: 30px;
    }

    .mail-body-content {
        white-space: pre-wrap;
        line-height: 1.8;
        font-size: 1.05rem;
        color: #334155;
        margin: 0;
    }

    /* ========== FOOTER ACTIONS ========== */
    .detail-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-premium-primary {
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 700;
        background: linear-gradient(135deg, #059669, #0891b2);
        color: #fff;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
        transition: all 0.25s ease;
    }

        .btn-premium-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(16, 185, 129, 0.45);
            color: #fff;
        }

    .btn-premium-secondary {
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.7);
        color: var(--text-main);
        border: 1px solid rgba(255, 255, 255, 0.9);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.25s ease;
    }

        .btn-premium-secondary:hover {
            background: #ffffff;
            color: #059669;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        }

    /* ========== ANIMATIONS ========== */
    .animate-fade-up {
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 768px) {
        .mail-shell {
            padding: 20px 12px;
        }

        .glass-detail-card {
            padding: 24px;
            border-radius: 20px;
        }

        .mail-subject {
            font-size: 1.4rem;
        }

        .mail-body-container {
            padding: 20px;
        }

        .detail-actions {
            justify-content: flex-start;
        }

        .btn-premium-primary, .btn-premium-secondary {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="mail-shell">
    <div class="glass-detail-card animate-fade-up">

        <!-- Üst Bar: Geri Butonu ve Tarih -->
        <div class="detail-top-bar">
            <a asp-controller="Message" asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> Gelen Kutusu
            </a>

            <div class="mail-date-badge">
                <i class="bi bi-clock me-1"></i>
                @Model.SendDate.ToString("dd.MM.yyyy HH:mm")
            </div>
        </div>

        <!-- Gönderen Bilgileri -->
        <div class="sender-box">
            <div class="sender-avatar">
                @Model.Sender.FirstName.Substring(0, 1)
            </div>
            <div class="sender-info">
                <h4 class="sender-name">@Model.Sender.FirstName @Model.Sender.LastName</h4>
                <p class="sender-email">@Model.Sender.Email</p>
            </div>
        </div>

        <!-- Konu -->
        <h1 class="mail-subject">
            @Model.Subject
        </h1>

        <!-- Mesaj İçeriği -->
        <div class="mail-body-container">
            <p class="mail-body-content">@Model.Body</p>
        </div>

        <!-- Alt Butonlar -->
        <div class="detail-actions">
            <!-- Yeni Mesaj Butonu -->
            <a asp-controller="Message"
               asp-action="SendMail"
               class="btn-premium-secondary">
                <i class="bi bi-pencil-square"></i>
                Yeni Mesaj
            </a>

            <!-- Yanıtla Butonu -->
            <a asp-controller="Message"
               asp-action="Reply"
               asp-route-id="@Model.Id"
               class="btn-premium-primary">
                <i class="bi bi-reply-fill"></i>
                Yanıtla
            </a>
        </div>

    </div>
</div>