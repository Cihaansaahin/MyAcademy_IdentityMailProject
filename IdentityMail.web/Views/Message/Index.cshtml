@model List<UserMessage>
@{
    ViewData["Title"] = "Gelen Kutusu";
    var starredCount = Model.Count(m => m.IsStarred);
    var unreadCount = Model.Count(m => !m.IsRead);
}

<!-- Bootstrap Icons & Google Fonts (Poppins) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    * {
        font-family: 'Poppins', sans-serif;
    }

    body {
        background: linear-gradient(135deg, #022c22, #064e3b, #0f766e, #042f2e);
        min-height: 100vh;
    }

    .glass-shell {
        background: rgba(255, 255, 255, 0.90);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 24px;
        box-shadow: 0 20px 45px rgba(2, 44, 34, 0.25);
        overflow: hidden;
    }

    /* Sol Menü Linkleri */
    .sidebar-nav-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        border-radius: 12px;
        color: #334155;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

        .sidebar-nav-item:hover {
            background: rgba(5, 150, 105, 0.12);
            color: #065f46;
        }

        .sidebar-nav-item.active {
            background: #059669;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35);
        }

            .sidebar-nav-item.active i {
                color: #ffffff !important;
            }

    /* Mail Satırları */
    .mail-item {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.04);
        border-radius: 14px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

        .mail-item:hover {
            border-color: rgba(5, 150, 105, 0.3);
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
            transform: translateY(-1px);
        }

        .mail-item.unread {
            background: #f0fdf4;
            border-left: 4px solid #059669;
        }

        .mail-item.read {
            background: #ffffff;
            border-left: 4px solid transparent;
        }

    /* Yıldız Butonu */
    .star-btn {
        border: none;
        background: transparent;
        color: #cbd5e1;
        cursor: pointer;
        font-size: 1.15rem;
        padding: 4px;
        line-height: 1;
        transition: transform 0.15s, color 0.15s;
    }

        .star-btn:hover {
            transform: scale(1.15);
        }

        .star-btn.starred {
            color: #f59e0b;
        }

    /* Satır İçi Hızlı Aksiyon Butonları */
    .hover-actions {
        opacity: 0.7;
        transition: opacity 0.2s ease;
    }

    .mail-item:hover .hover-actions {
        opacity: 1;
    }

    .custom-input {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        transition: all 0.2s;
    }

        .custom-input:focus {
            background: #ffffff;
            border-color: #059669;
            box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
        }
</style>

<div class="container-fluid py-4 px-lg-5">
    <div class="row g-4">

        <!-- SOL PANEL (SIDEBAR) -->
        <aside class="col-lg-3">
            <div class="glass-shell p-4 d-flex flex-column gap-3">

                <!-- Profil Bilgisi -->
                <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-4 border shadow-sm">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold fs-5 flex-shrink-0 shadow-sm" style="width: 48px; height: 48px;">
                        @(ViewBag.fullName != null ? ViewBag.fullName.ToString().Substring(0, 1) : "U")
                    </div>
                    <div class="overflow-hidden flex-grow-1">
                        <h6 class="mb-0 text-truncate" style="font-weight: 700; font-size: 1rem; line-height: 1.2; color: #0f172a;">@ViewBag.fullName</h6>
                        <small style="display: inline-block; font-size: 0.7rem; font-weight: 600; color: #059669; background: rgba(16, 185, 129, 0.12); padding: 2px 8px; border-radius: 10px; margin-top: 4px;">Hoş Geldiniz</small>
                        <div>
                            <a asp-controller="Profile" asp-action="Index" class="btn btn-xs btn-outline-success rounded-pill mt-1" style="font-size: 0.75rem; padding: 2px 8px; font-weight: 600;">
                                <i class="bi bi-person-gear-fill me-1"></i> Düzenle
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Yeni Mesaj Butonu -->
                <a asp-controller="Message" asp-action="SendMail" class="btn btn-success rounded-pill py-2.5 d-flex align-items-center justify-content-center gap-2 shadow-sm" style="font-weight: 700;">
                    <i class="bi bi-pencil-square"></i> Yeni Mesaj
                </a>

                <hr class="my-1 border-secondary-subtle opacity-50">

                <!-- Menü -->
                <nav class="d-flex flex-column gap-1">
                    <a asp-controller="Message" asp-action="Index" class="sidebar-nav-item active">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-inbox-fill"></i>
                            <span>Gelen Kutusu</span>
                        </div>
                        <span class="badge rounded-pill px-2" style="font-size: 0.75rem; font-weight: 700; background: #059669; color: #fff;">@Model.Count</span>
                    </a>
                    <a asp-controller="Message" asp-action="StarredMessages" class="sidebar-nav-item">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-star-fill text-warning"></i>
                            <span>Yıldızlı</span>
                        </div>
                        @if (starredCount > 0)
                        {
                            <span class="badge rounded-pill px-2" style="font-size: 0.75rem; font-weight: 700; background: rgba(100, 116, 139, 0.1); color: #64748b;">@starredCount</span>
                        }
                    </a>
                    <a asp-controller="Message" asp-action="SentMessages" class="sidebar-nav-item">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-send-fill text-primary"></i>
                            <span>Gönderilenler</span>
                        </div>
                    </a>
                    <a asp-controller="Message" asp-action="Trash" class="sidebar-nav-item text-danger">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-trash-fill text-danger"></i>
                            <span>Çöp Kutusu</span>
                        </div>
                    </a>
                </nav>

                <!-- Çıkış Butonu -->
                <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill mt-auto pt-2 pb-2" style="font-weight: 700;">
                    <i class="bi bi-box-arrow-right me-1"></i> Güvenli Çıkış
                </a>
            </div>
        </aside>

        <!-- SAĞ PANEL (MESAJ LİSTESİ) -->
        <main class="col-lg-9">
            <div class="glass-shell p-4">

                <!-- Üst Başlık & Arama Çubuğu -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-3 border-bottom">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="mb-0 text-dark" style="font-weight: 800; font-size: 1.5rem;">Gelen Kutusu</h4>
                            @if (unreadCount > 0)
                            {
                                <span class="badge rounded-pill" style="font-size: 0.72rem; font-weight: 700; padding: 4px 10px; background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff;">@unreadCount okunmamış</span>
                            }
                        </div>
                        <p class="mb-0" style="color: #64748b; font-size: 0.88rem; margin-top: 4px;">Gelen tüm e-postalarınız burada listelenmektedir.</p>
                    </div>

                    <!-- Arama Kutusu -->
                    <div class="flex-grow-1" style="max-width: 360px;">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="mailSearchInput" class="form-control custom-input border-start-0 rounded-end-pill py-2" placeholder="Gönderen veya konuya göre ara..." onkeyup="filterMailRows()" style="font-size: 0.9rem;">
                        </div>
                    </div>
                </div>

                <!-- Filtreler & Kontroller Toolbar -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 bg-white p-2 rounded-3 border shadow-sm">
                    <!-- Durum Filtreleri -->
                    <div class="btn-group btn-group-sm" role="group">
                        <a asp-controller="Message" asp-action="Index" class="btn btn-outline-secondary border-0" style="font-weight: 600; font-size: 0.85rem;">Tümü</a>
                        <a asp-controller="Message" asp-action="Index" asp-route-filter="read" class="btn btn-outline-secondary border-0" style="font-weight: 600; font-size: 0.85rem;">Okunan</a>
                        <a asp-controller="Message" asp-action="Index" asp-route-filter="unread" class="btn btn-outline-secondary border-0" style="font-weight: 600; font-size: 0.85rem;">Okunmayan</a>
                        <a asp-controller="Message" asp-action="Index" asp-route-filter="starred" class="btn btn-outline-secondary border-0" style="font-weight: 600; font-size: 0.85rem;">Yıldızlı</a>
                    </div>

                    <!-- Dropdown Filtreler -->
                    <div class="d-flex gap-2 flex-wrap">
                        @if (ViewBag.Categories != null)
                        {
                            <form asp-controller="Message" asp-action="Index" method="get" class="m-0">
                                <input type="hidden" name="filter" value="@Context.Request.Query["filter"]" />
                                <input type="hidden" name="sort" value="@Context.Request.Query["sort"]" />
                                <select name="categoryId" class="form-select form-select-sm rounded-pill custom-input" onchange="this.form.submit()" style="font-weight: 600; font-size: 0.85rem;">
                                    <option value="">📁 Tüm Kategoriler</option>
                                    @foreach (var item in ViewBag.Categories)
                                    {
                                        <option value="@item.Id" selected="@(ViewBag.SelectedCategory != null && (int)ViewBag.SelectedCategory == item.Id)">
                                            @item.Name
                                        </option>
                                    }
                                </select>
                            </form>
                        }

                        <form asp-controller="Message" asp-action="Index" method="get" class="m-0">
                            <input type="hidden" name="filter" value="@Context.Request.Query["filter"]" />
                            <input type="hidden" name="categoryId" value="@Context.Request.Query["categoryId"]" />
                            <select name="sort" class="form-select form-select-sm rounded-pill custom-input" onchange="this.form.submit()" style="font-weight: 600; font-size: 0.85rem;">
                                <option value="">↕️ Sıralama</option>
                                <option value="new">En Yeni</option>
                                <option value="old">En Eski</option>
                                <option value="az">A-Z</option>
                                <option value="za">Z-A</option>
                            </select>
                        </form>
                    </div>
                </div>

                <!-- Mesaj Listesi -->
                <div id="mailList" class="d-flex flex-column gap-2">
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <div class="mail-item @(item.IsRead ? "read" : "unread") p-3 d-flex align-items-center gap-3" data-search="@($"{item.Sender.FirstName} {item.Sender.LastName} {item.Sender.Email} {item.Subject}".ToLower())">

                                <!-- Yıldızlama Butonu -->
                                <button type="button" class="star-btn @(item.IsStarred ? "starred" : "") flex-shrink-0" onclick="toggleStar(this, @item.Id)" title="Yıldızla">
                                    <i class="bi @(item.IsStarred ? "bi-star-fill" : "bi-star")"></i>
                                </button>

                                <!-- Avatar -->
                                <div class="rounded-circle bg-light text-dark d-flex align-items-center justify-content-center border flex-shrink-0 shadow-sm" style="width: 40px; height: 40px; font-size: 1.1rem; font-weight: 700;">
                                    @item.Sender.FirstName.Substring(0, 1)
                                </div>

                                <!-- Mesaj Özeti & Gönderen -->
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                        <span class="text-truncate" style="max-width: 220px; font-weight: 700; font-size: 0.95rem; color: #0f172a;">
                                            @item.Sender.FirstName @item.Sender.LastName
                                        </span>
                                        <small style="font-weight: 400; color: #64748b; font-size: 0.82rem;">@item.Sender.Email</small>

                                        @if (!item.IsRead)
                                        {
                                            <span class="badge rounded-pill px-2 py-0.5" style="font-size: 0.72rem; font-weight: 700; background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff;">Yeni</span>
                                        }
                                    </div>
                                    <div class="text-truncate" style="font-size: 0.85rem;">
                                        <span style="display: inline-block; font-weight: 600; font-size: 0.85rem; color: #1e293b; background: rgba(241, 245, 249, 0.8); padding: 3px 10px; border-radius: 8px;">@item.Subject</span>
                                        <span class="mx-1 text-muted">•</span>
                                        <span style="color: #64748b; font-size: 0.82rem;">@(item.Body?.Length > 60 ? item.Body.Substring(0, 60) + "..." : item.Body)</span>
                                    </div>
                                </div>

                                <!-- Tarih Bilgisi -->
                                <div class="text-nowrap flex-shrink-0" style="color: #64748b; font-size: 0.82rem; font-weight: 500;">
                                    @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                                </div>

                                <!-- İşlem Aksiyonları -->
                                <div class="hover-actions d-flex gap-1 flex-shrink-0">
                                    <a asp-controller="Message" asp-action="MailDetail" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-circle shadow-sm" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Görüntüle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Message" asp-action="MoveToTrash" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border rounded-circle shadow-sm" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Çöp Kutusu">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 bg-white rounded-4 border" style="color: #64748b;">
                            <i class="bi bi-inbox text-secondary fs-1 d-block mb-2 opacity-50"></i>
                            <h6 style="font-weight: 600; font-size: 0.95rem; color: #64748b;">Gelen kutunuzda mesaj bulunmuyor.</h6>
                        </div>
                    }
                </div>

            </div>
        </main>
    </div>
</div>

<script>
    function filterMailRows() {
        const query = document.getElementById('mailSearchInput').value.toLowerCase();
        document.querySelectorAll('#mailList .mail-item').forEach(function (row) {
            const text = row.getAttribute('data-search') || '';
            row.style.display = text.includes(query) ? '' : 'none';
        });
    }

    function toggleStar(btn, messageId) {
        const icon = btn.querySelector('i');
        const isNowStarred = !btn.classList.contains('starred');

        btn.classList.toggle('starred', isNowStarred);
        icon.classList.toggle('bi-star', !isNowStarred);
        icon.classList.toggle('bi-star-fill', isNowStarred);

        fetch(`/Message/ToggleStar/${messageId}`, { method: 'POST' });
    }
</script>



