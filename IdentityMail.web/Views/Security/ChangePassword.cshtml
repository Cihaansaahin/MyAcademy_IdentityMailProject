@model IdentityMail.web.DTOs.ProfileDtos.ChangePasswordDto
@{
    ViewData["Title"] = "Şifre Değiştir";
}

<!-- Bootstrap Icons & Google Fonts (Poppins) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* ========== THEME & VARIABLES ========== */
    :root {
        --brand-1: #022c22;
        --brand-2: #064e3b;
        --brand-3: #059669;
        --brand-4: #10b981;
        --brand-5: #06b6d4;
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(255, 255, 255, 0.4);
        --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.12);
        --text-main: #0f172a;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Poppins', sans-serif;
    }

    /* ========== ANIMATED BACKGROUND ========== */
    .auth-shell {
        min-height: 100vh;
        padding: 40px 24px;
        background: linear-gradient(-45deg, #022c22, #064e3b, #0f766e, #042f2e);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        color: var(--text-main);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ========== GLASSMORPHISM CONTAINER ========== */
    .glass-auth-card {
        background: var(--glass-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        border-radius: 24px;
        width: 100%;
        max-width: 500px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        padding: 40px;
        position: relative;
    }

    /* ========== HEADER ========== */
    .auth-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .icon-circle-premium {
        width: 72px;
        height: 72px;
        border-radius: 22px;
        background: linear-gradient(135deg, #10b981, #06b6d4);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
        margin-bottom: 20px;
    }

    .auth-title {
        font-weight: 800;
        font-size: 1.75rem;
        color: var(--text-main);
        margin-bottom: 8px;
    }

    .auth-subtitle {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin: 0;
    }

    /* ========== FORM ELEMENTS ========== */
    .form-label-premium {
        font-weight: 700;
        font-size: 0.9rem;
        color: #334155;
        margin-bottom: 8px;
        display: block;
    }

    .premium-input-group {
        position: relative;
        display: flex;
        align-items: center;
    }

        .premium-input-group i {
            position: absolute;
            left: 20px;
            color: var(--text-muted);
            font-size: 1.15rem;
            z-index: 10;
            transition: color 0.25s ease;
        }

    .form-control-premium {
        width: 100%;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 16px;
        padding: 14px 20px 14px 52px;
        font-size: 1rem;
        color: var(--text-main);
        transition: all 0.25s ease;
        box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.02);
        outline: none;
    }

        .form-control-premium:focus {
            background: #ffffff;
            border-color: var(--brand-3);
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2);
        }

    .premium-input-group:focus-within i {
        color: var(--brand-3);
    }

    /* ========== ALERTS ========== */
    .glass-alert-success {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #065f46;
        border-radius: 16px;
        padding: 14px 20px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        backdrop-filter: blur(8px);
    }

    /* ========== BUTTONS ========== */
    .btn-premium-primary {
        width: 100%;
        padding: 16px;
        border-radius: 16px;
        font-weight: 700;
        font-size: 1.05rem;
        background: linear-gradient(135deg, #059669, #0891b2);
        color: #fff;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
        transition: all 0.25s ease;
        margin-top: 24px;
        cursor: pointer;
    }

        .btn-premium-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(16, 185, 129, 0.45);
            color: #fff;
        }

    .auth-footer {
        margin-top: 24px;
        text-align: center;
        padding-top: 20px;
        border-top: 1px solid rgba(226, 232, 240, 0.6);
    }

    .btn-link-premium {
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: color 0.2s ease;
    }

        .btn-link-premium:hover {
            color: var(--brand-3);
        }

    /* ========== ANIMATIONS ========== */
    .animate-fade-up {
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 576px) {
        .glass-auth-card {
            padding: 30px 24px;
        }

        .auth-shell {
            padding: 20px 12px;
        }
    }
</style>

<div class="auth-shell">
    <div class="glass-auth-card animate-fade-up">

        <!-- Başlık Kısmı -->
        <div class="auth-header">
            <div class="icon-circle-premium">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h2 class="auth-title">Şifre Değiştir</h2>
            <p class="auth-subtitle">Hesabınızın güvenliğini sağlamak için yeni bir şifre belirleyin.</p>
        </div>

        <!-- Başarılı İşlem Bildirimi -->
        @if (TempData["Success"] != null)
        {
            <div class="glass-alert-success">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["Success"]</div>
            </div>
        }

        <!-- Hata Özeti -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 border-0 shadow-sm mb-4"></div>

        <!-- Form Alanı -->
        <form asp-action="ChangePassword" method="post">

            <!-- Mevcut Şifre -->
            <div class="mb-4">
                <label asp-for="CurrentPassword" class="form-label-premium">
                    Mevcut Şifre
                </label>
                <div class="premium-input-group">
                    <i class="bi bi-unlock"></i>
                    <input asp-for="CurrentPassword"
                           class="form-control-premium"
                           type="password"
                           placeholder="Mevcut şifrenizi giriniz" />
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Yeni Şifre -->
            <div class="mb-4">
                <label asp-for="NewPassword" class="form-label-premium">
                    Yeni Şifre
                </label>
                <div class="premium-input-group">
                    <i class="bi bi-key"></i>
                    <input asp-for="NewPassword"
                           class="form-control-premium"
                           type="password"
                           placeholder="Yeni şifrenizi giriniz" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Yeni Şifre Tekrar -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label-premium">
                    Yeni Şifre Tekrar
                </label>
                <div class="premium-input-group">
                    <i class="bi bi-check2-circle"></i>
                    <input asp-for="ConfirmPassword"
                           class="form-control-premium"
                           type="password"
                           placeholder="Yeni şifrenizi tekrar giriniz" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Gönder Butonu -->
            <button type="submit" class="btn-premium-primary">
                <i class="bi bi-shield-check"></i>
                Şifreyi Güncelle
            </button>

        </form>

        <!-- Alt Kısım / Geri Dönüş -->
        <div class="auth-footer">
            <a asp-controller="Profile" asp-action="Index" class="btn-link-premium">
                <i class="bi bi-arrow-left"></i>
                Profilime Dön
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}