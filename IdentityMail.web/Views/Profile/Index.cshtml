@model AppUser
@{
    ViewData["Title"] = "Profilim";
}

<!-- Bootstrap Icons & Google Fonts (Poppins) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* ========== THEME & VARIABLES ========== */
    :root {
        --brand-1: #022c22;
        --brand-2: #064e3b;
        --brand-3: #059669;
        --brand-4: #10b981;
        --brand-5: #06b6d4;
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(255, 255, 255, 0.4);
        --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.12);
        --text-main: #0f172a;
        --text-muted: #64748b;
    }

    * {
        font-family: 'Poppins', sans-serif;
    }

    /* ========== ANIMATED BACKGROUND ========== */
    .profile-shell {
        min-height: 100vh;
        padding: 40px 24px;
        background: linear-gradient(-45deg, #022c22, #064e3b, #0f766e, #042f2e);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        color: var(--text-main);
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ========== GLASSMORPHISM CONTAINER ========== */
    .glass-profile-card {
        background: var(--glass-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        border-radius: 24px;
        width: 100%;
        max-width: 800px;
        padding: 40px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    /* ========== TOP BAR ========== */
    .profile-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(226, 232, 240, 0.6);
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.9);
        color: var(--text-main);
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
    }

        .btn-back:hover {
            background: #ffffff;
            color: var(--brand-3);
            transform: translateX(-4px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        }

    .profile-header-title {
        font-weight: 800;
        font-size: 1.5rem;
        margin: 0;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ========== AVATAR SECTION ========== */
    .avatar-upload-box {
        text-align: center;
        margin-bottom: 35px;
        position: relative;
    }

    .avatar-wrapper {
        position: relative;
        display: inline-block;
    }

    .profile-avatar-img {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #ffffff;
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.25);
        background-color: #f1f5f9;
        transition: transform 0.3s ease;
    }

    .avatar-wrapper:hover .profile-avatar-img {
        transform: scale(1.05);
    }

    /* ========== FORM ELEMENTS ========== */
    .form-label-premium {
        font-weight: 700;
        font-size: 0.9rem;
        color: #334155;
        margin-bottom: 8px;
        display: block;
    }

    .premium-input-group {
        position: relative;
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

        .premium-input-group i {
            position: absolute;
            left: 20px;
            color: var(--text-muted);
            font-size: 1.15rem;
            z-index: 10;
            transition: color 0.25s ease;
        }

    .form-control-premium {
        width: 100%;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 16px;
        padding: 14px 20px 14px 52px;
        font-size: 1rem;
        color: var(--text-main);
        transition: all 0.25s ease;
        box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.02);
        outline: none;
    }

        .form-control-premium:focus {
            background: #ffffff;
            border-color: var(--brand-3);
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2);
        }

    .premium-input-group:focus-within i {
        color: var(--brand-3);
    }

    /* Readonly Inputs Styling */
    .form-control-premium[readonly] {
        background: rgba(241, 245, 249, 0.5);
        color: #64748b;
        cursor: not-allowed;
        border-color: rgba(226, 232, 240, 0.6);
    }

    /* ========== ALERTS ========== */
    .glass-alert-success {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #065f46;
        border-radius: 16px;
        padding: 16px 20px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        backdrop-filter: blur(8px);
    }

    /* ========== BUTTONS ========== */
    .btn-premium-primary {
        width: 100%;
        padding: 16px;
        border-radius: 16px;
        font-weight: 700;
        font-size: 1.05rem;
        background: linear-gradient(135deg, #059669, #0891b2);
        color: #fff;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
        transition: all 0.25s ease;
        cursor: pointer;
    }

        .btn-premium-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(16, 185, 129, 0.45);
            color: #fff;
        }

    .btn-premium-danger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 14px 28px;
        border-radius: 14px;
        font-weight: 600;
        background: rgba(254, 242, 242, 0.8);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
        text-decoration: none;
        transition: all 0.25s ease;
    }

        .btn-premium-danger:hover {
            background: #ef4444;
            color: #ffffff;
            box-shadow: 0 6px 15px rgba(239, 68, 68, 0.25);
            transform: translateY(-2px);
        }

    /* ========== ANIMATIONS ========== */
    .animate-fade-up {
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 576px) {
        .glass-profile-card {
            padding: 30px 20px;
        }

        .profile-shell {
            padding: 20px 12px;
        }

        .profile-top-bar {
            flex-direction: column-reverse;
            gap: 16px;
            align-items: flex-start;
        }
    }
</style>

<div class="profile-shell">
    <div class="glass-profile-card animate-fade-up">

        <!-- Üst Bar: Geri Butonu ve Başlık -->
        <div class="profile-top-bar">
            <a asp-controller="Message" asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> Geri Dön
            </a>

            <h3 class="profile-header-title">
                <i class="bi bi-person-bounding-box" style="color: #10b981;"></i>
                @Model.FirstName @Model.LastName
            </h3>
        </div>

        <!-- Başarı Mesajı -->
        @if (TempData["Success"] != null)
        {
            <div class="glass-alert-success">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["Success"]</div>
            </div>
        }

        <form asp-action="ProfileUpdate" method="post">

            <!-- Avatar Görüntüleme -->
            <div class="avatar-upload-box">
                <div class="avatar-wrapper">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl" alt="Profil Fotoğrafı" class="profile-avatar-img" />
                    }
                    else
                    {
                        <img src="https://resmim.net/cdn/2026/09/19/E95vxQ.jpg" alt="Profil Fotoğrafı" class="profile-avatar-img" />
                    }
                </div>
            </div>

            <!-- Profil Fotoğrafı URL -->
            <label class="form-label-premium">Profil Fotoğrafı URL</label>
            <div class="premium-input-group">
                <i class="bi bi-link-45deg"></i>
                <input asp-for="ProfileImageUrl" class="form-control-premium" placeholder="https://..." />
            </div>

            <!-- Ad / Soyad Satırı -->
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label-premium">Ad</label>
                    <div class="premium-input-group">
                        <i class="bi bi-person"></i>
                        <input asp-for="FirstName" class="form-control-premium" placeholder="Adınız" />
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label-premium">Soyad</label>
                    <div class="premium-input-group">
                        <i class="bi bi-person"></i>
                        <input asp-for="LastName" class="form-control-premium" placeholder="Soyadınız" />
                    </div>
                </div>
            </div>

            <!-- Telefon -->
            <label class="form-label-premium">Telefon</label>
            <div class="premium-input-group">
                <i class="bi bi-telephone"></i>
                <input asp-for="PhoneNumber" class="form-control-premium" placeholder="05XX XXX XX XX" />
            </div>

            <!-- Email (Readonly) -->
            <label class="form-label-premium">Email Adresi (Değiştirilemez)</label>
            <div class="premium-input-group">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email" class="form-control-premium" readonly />
            </div>

            <!-- Kullanıcı Adı (Readonly) -->
            <label class="form-label-premium">Kullanıcı Adı (Değiştirilemez)</label>
            <div class="premium-input-group">
                <i class="bi bi-at"></i>
                <input asp-for="UserName" class="form-control-premium" readonly />
            </div>

            <!-- Gönder Butonu -->
            <div class="mt-4">
                <button type="submit" class="btn-premium-primary">
                    <i class="bi bi-check2-circle fs-5"></i>
                    Profili Güncelle
                </button>
            </div>

        </form>

        <hr class="my-4" style="border-color: rgba(226, 232, 240, 0.8);" />

        <!-- Şifre Değiştirme Yönlendirmesi -->
        <div class="text-center">
            <a asp-controller="Security" asp-action="ChangePassword" class="btn-premium-danger">
                <i class="bi bi-shield-lock-fill"></i>
                Şifre Değiştir
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}